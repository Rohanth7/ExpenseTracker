<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews can't use the app's Anek Latin font, so text is the system sans-serif. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_shell"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Decorative: what she means is in the text beside her. -->
        <ImageView
            android:id="@+id/widget_mascot"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8E94C6"
                android:textSize="11.5sp" />

            <!-- Text sizes here are the design's; the widget shrinks them to fit its width (fitSp). -->
            <TextView
                android:id="@+id/widget_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="#F4EEDD"
                android:textSize="23sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ImageView
            android:id="@+id/widget_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_widget_add"
            android:contentDescription="Add expense"
            android:padding="10dp"
            android:src="@drawable/ic_widget_add" />

    </LinearLayout>

    <!-- Two bars, one per colour: RemoteViews can't change a bar's drawable. -->
    <ProgressBar
        android:id="@+id/widget_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_bar_gold"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/widget_bar_over"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="100"
        android:progressDrawable="@drawable/widget_bar_pink"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_used"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8E94C6"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/widget_days_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8E94C6"
            android:textSize="11.5sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif"
        android:textColor="#8E94C6"
        android:textSize="11.5sp"
        android:visibility="gone" />

</LinearLayout>
